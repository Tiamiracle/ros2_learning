<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="single_imu" params="name parent x y z r p yaw">
        <link name="${name}_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="0.06 0.04 0.02" />
                </geometry>
                <material name="imu_red">
                    <color rgba="0.8 0.3 0.3 1" />
                </material>
            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="0.06 0.04 0.02" />
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="0.05" />
                <inertia ixx="0.000017" ixy="0" ixz="0"
                    iyy="0.000028" iyz="0"
                    izz="0.000032" />
            </inertial>
        </link>

        <joint name="${name}_joint" type="fixed">
            <parent link="${parent}" />
            <child link="${name}_link" />
            <origin xyz="${x} ${y} ${z}" rpy="${r} ${p} ${yaw}" />
        </joint>
    </xacro:macro>

</robot>