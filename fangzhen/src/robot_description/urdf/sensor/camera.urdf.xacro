<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="camera_xacro" params="prefix parent x y z r p yaw">
        <link name="${prefix}_camera_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="0.08 0.06 0.05" />
                </geometry>
                <material name="camera_blue">
                    <color rgba="0.3 0.4 0.9 1" />
                </material>
            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="0.08 0.06 0.05" />
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="0.05" />
                <inertia ixx="0.000042" ixy="0" ixz="0"
                    iyy="0.000057" iyz="0"
                    izz="0.000068" />
            </inertial>
        </link>
        <gazebo reference="${prefix}_camera_link">
            <material>Gazebo/Red</material>
        </gazebo>

        <!-- 2. 相机传感器与驱动插件 -->
        <gazebo reference="${prefix}_camera_link">
            <sensor name="camera_sensor" type="camera">
                <update_rate>30</update_rate> <!-- 帧率 30Hz -->
                <camera>
                    <horizontal_fov>1.047</horizontal_fov> <!-- 水平视场角约60度 -->
                    <image>
                        <width>640</width>   <!-- 图像宽度 -->
                        <height>480</height> <!-- 图像高度 -->
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.1</near>   <!-- 近裁剪面（太近的物体不渲染） -->
                        <far>100</far>     <!-- 远裁剪面 -->
                    </clip>
                </camera>

                <!-- 加载 ROS 2 相机插件 -->
                <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                    <ros>
                        <namespace>/</namespace>
                        <!-- 话题重映射，方便统一管理 -->
                        <remapping>image_raw:=camera/image_raw</remapping>
                        <remapping>camera_info:=camera/camera_info</remapping>
                    </ros>

                    <alwaysOn>true</alwaysOn>
                    <updateRate>0.0</updateRate> <!-- 0 表示跟随 sensor 的 update_rate -->
                    <cameraName>camera</cameraName>

                    <!-- 话题名称 -->
                    <imageTopicName>image_raw</imageTopicName>
                    <cameraInfoTopicName>camera_info</cameraInfoTopicName>

                    <!-- 坐标系名称，必须与实际 link 名字一致 -->
                    <frameName>${prefix}_camera_link</frameName>
                </plugin>
            </sensor>
        </gazebo>
        <joint name="${prefix}_camera_joint" type="fixed">
            <parent link="${parent}" />
            <child link="${prefix}_camera_link" />
            <origin xyz="${x} ${y} ${z}" rpy="${r} ${p} ${yaw}" />
        </joint>
    </xacro:macro>

</robot>