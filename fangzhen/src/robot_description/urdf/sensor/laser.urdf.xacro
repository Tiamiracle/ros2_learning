<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="laser_xacro" params="prefix parent x y z r p yaw">
        <!-- 第一部分：支撑立柱 -->
        <link name="${prefix}_cylinder_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder length="0.06" radius="0.02" />
                </geometry>
                <material name="gray">
                    <color rgba="0.7 0.7 0.7 1.0" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder length="0.06" radius="0.02" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="0.04" />
                <inertia ixx="0.000015" ixy="0" ixz="0"
                    iyy="0.000015" iyz="0"
                    izz="0.000025" />
            </inertial>
        </link>
        <joint name="${prefix}_cylinder_joint" type="fixed">
            <parent link="${parent}" />
            <child link="${prefix}_cylinder_link" />
            <origin xyz="${x} ${y} ${z}" rpy="${r} ${p} ${yaw}" />
        </joint>

        <!-- 第二部分：激光雷达本体，就是你刚才写的这个 -->
        <link name="${prefix}_laser_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder length="0.05" radius="0.06" />
                </geometry>
                <material name="laser_cyan">
                    <color rgba="0.3 0.8 0.8 1" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder length="0.05" radius="0.06" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="0.1" />
                <inertia ixx="0.0000925" ixy="0" ixz="0"
                    iyy="0.0000925" iyz="0"
                    izz="0.00018" />
            </inertial>
        </link>
        <!-- 雷达挂在立柱顶端，z向上挪一点 -->
        <joint name="${prefix}_laser_joint" type="fixed">
            <parent link="${prefix}_cylinder_link" />
            <child link="${prefix}_laser_link" />
            <origin xyz="0 0 0.055" rpy="0 0 0" />
        </joint>
    </xacro:macro>


</robot>