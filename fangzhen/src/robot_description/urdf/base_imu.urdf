<?xml version="1.0"?>
<robot name="base_imu_robot">
    <!-- ========== 底座 base_link ========== -->
    <link name="base_link">
        <!-- 可视化模型：圆柱底座 -->
        <visual>
            <geometry>
                <cylinder radius="0.3" length="0.2" />
            </geometry>
            <material name="gray">
                <color rgba="0.7 0.7 0.7 1.0" />
            </material>
        </visual>
        <!-- 碰撞体（仿真物理用，现在先只做rviz可视化，简单写） -->
        <collision>
            <geometry>
                <cylinder radius="0.3" length="0.2" />
            </geometry>
        </collision>
        <!-- 惯性（物理属性，后面一节学，这里先占位） -->
        <inertial>
            <mass value="5.0" />
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.2" />
        </inertial>
    </link>

    <!-- ========== IMU link ========== -->
    <link name="imu_link">
        <visual>
            <geometry>
                <box size="0.06 0.04 0.02" />
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.06 0.04 0.02" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.05" />
            <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
        </inertial>
    </link>
</robot>