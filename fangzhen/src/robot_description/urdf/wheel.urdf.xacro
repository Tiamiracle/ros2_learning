<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="wheel_xacro" params="prefix parent x y z">
        <link name="${prefix}_wheel_link">
            <visual>
                <!-- 修正：绕X轴转90度，让圆柱的轴心变成横向的Y轴 -->
                <origin xyz="0 0 0" rpy="1.5708 0 0" />
                <geometry>
                    <cylinder length="0.05" radius="0.07" />
                </geometry>
                <material name="wheel_yellow">
                    <color rgba="1.0 0.8 0.0 1" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="1.5708 0 0" />
                <geometry>
                    <cylinder length="0.05" radius="0.07" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="1.5708 0 0" />
                <mass value="0.3" />
                <inertia ixx="0.0007875" ixy="0" ixz="0"
                    iyy="0.0007875" iyz="0"
                    izz="0.00147" />
            </inertial>
        </link>
        <gazebo reference="${prefix}_wheel_link">
            <material>Gazebo/Yellow</material>
            <!-- 加上摩擦力，防止原地打滑 -->
            <mu1>1.0</mu1>
            <mu2>1.0</mu2>
        </gazebo>
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="${parent}" />
            <child link="${prefix}_wheel_link" />
            <origin xyz="${x} ${y} ${z}" rpy="0 0 0" />
            <!-- 修正：旋转轴改为横向的Y轴 -->
            <axis xyz="0 1 0" />
            <!-- 加点阻尼，防止溜车 -->
            <dynamics damping="0.1" friction="0.1" />
        </joint>
    </xacro:macro>
</robot>