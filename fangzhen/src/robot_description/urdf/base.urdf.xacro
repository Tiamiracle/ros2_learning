<?xml version="1.0"?>
<robot name="base_imu_robot" xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:macro name="base_xacro">

        <!-- 1. 唯一根节点：虚拟投影点，没有任何物理属性 -->
        <link name="base_footprint" />

        <!-- 2. 关节连接：footprint 在上面，base_link 在下面 -->
        <joint name="base_footprint_joint" type="fixed">
            <parent link="base_footprint" />
            <child link="base_link" />
            <!-- z 设为底盘半高（0.05），把底盘从地面抬起 -->
            <origin xyz="0 0 0.08" rpy="0 0 0" />
        </joint>

        <!-- 3. 真实底盘：挂在 base_footprint 上面 -->
        <link name="base_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="0.3 0.2 0.1" />
                </geometry>
                <material name="base_gray">
                    <color rgba="0.5 0.5 0.5 1" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="0.3 0.2 0.1" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="2.0" />
                <inertia ixx="0.00833" ixy="0" ixz="0" iyy="0.01083" iyz="0" izz="0.01300" />
            </inertial>
        </link>

        <!-- 4. Gazebo 专属颜色，防止显示为灰色 -->
        <gazebo reference="base_link">
            <material>Gazebo/Blue</material>
        </gazebo>

    </xacro:macro>
</robot>